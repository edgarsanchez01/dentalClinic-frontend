# DentalClinic frontend - variables de entorno (ejemplo).
#
# Solo valores PUBLICOS. Todo `VITE_*` se incrusta en el bundle: nunca pongas
# un secreto aqui (Architecture.md 14.4, 19.2).
#
# Copiar a `.env.local` solo en desarrollo.

# Base URL del backend que usa el cliente HTTP central (Architecture.md 14.4).
# Vacio = mismo origen. En desarrollo, el proxy de Vite expone /actuator.
VITE_API_BASE_URL=

# Destino del proxy de Vite para /actuator/health en desarrollo.
VITE_API_PROXY_TARGET=http://localhost:8080